# =============================================================================
# LORD SAI SHARE MARKET CLASSES — BACKEND ENVIRONMENT TEMPLATE
# =============================================================================
# Copy this file to ".env" and fill in real values.
# NEVER commit the real ".env" file — it is git-ignored on purpose.
# =============================================================================

# --- Database (MySQL) --------------------------------------------------------
DB_URL=jdbc:mysql://localhost:3306/lsi_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Kolkata
DB_USERNAME=lsi_app
DB_PASSWORD=replace_with_database_password

# Flyway runs the versioned schema migrations. Enabled from Phase 2 onward.
FLYWAY_ENABLED=true

# --- JWT ---------------------------------------------------------------------
# Must be a long random string (minimum 32 characters for HS256).
# Generate one with:  openssl rand -base64 48
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_ACCESS_TOKEN_MINUTES=120
JWT_REFRESH_TOKEN_DAYS=7

# --- Razorpay ----------------------------------------------------------------
# OPTIONAL. The Main Admin normally configures Razorpay from the dashboard
# (Payment Gateway page); credentials saved there take precedence over these.
# When neither exists the website runs in DEMO PAYMENT mode (no money charged).
# Found in Razorpay Dashboard > Settings > API Keys. Use rzp_test_* while developing.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_with_razorpay_key_secret
# Razorpay Dashboard > Settings > Webhooks > Secret
RAZORPAY_WEBHOOK_SECRET=replace_with_webhook_secret

# --- SMTP Email --------------------------------------------------------------
# PREFERRED: configure SMTP from the Main Admin panel (System > Email Settings).
# Settings saved there are encrypted in the database and take precedence over
# everything below; the variables here are only a fallback when nothing is saved.
#
# IMPORTANT: the enrollment email is the ONLY thing that carries the student's
# password-setup link. With MAIL_ENABLED=false nothing is sent — the email is written
# to the application log instead (look for [EMAIL:DEV-SINK] lines, which print the
# setup link), the checkout screen says the email could not be sent, and the student
# must use "Resend setup email" once SMTP works.
# Set MAIL_ENABLED=true on any server where real students buy courses.
MAIL_ENABLED=false
# For Gmail use an App Password (not the account password).
# For SendGrid: MAIL_HOST=smtp.sendgrid.net, MAIL_USERNAME=apikey, MAIL_PASSWORD=your_api_key
# For Resend:   MAIL_HOST=smtp.resend.com, MAIL_USERNAME=resend, MAIL_PASSWORD=your_re_api_key
# For Mailgun:  MAIL_HOST=smtp.mailgun.org, MAIL_USERNAME=postmaster@..., MAIL_PASSWORD=...
# For SES:      MAIL_HOST=email-smtp.ap-south-1.amazonaws.com, MAIL_USERNAME=..., MAIL_PASSWORD=...
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=replace_with_smtp_username
MAIL_PASSWORD=replace_with_smtp_app_password
MAIL_FROM=Lord Sai Academy <no-reply@lordsaiinvestment.com>
MAIL_REPLY_TO=info@lordsaiinvestment.com
# Verified custom domain for SPF/DKIM/DMARC alignment:
MAIL_SENDING_DOMAIN=lordsaiinvestment.com
MAIL_DKIM_SELECTOR=default

# --- Gmail via Google OAuth 2.0 (recommended) --------------------------------
# Lets the Main Admin connect the academy's Google account once, on
# Main Admin > Email Settings > Connect Google Account. Mail is then sent through
# the Gmail API with a refresh token stored encrypted in the database.
# No Gmail password and no App Password is involved at any point.
#
# Create these in Google Cloud: enable the Gmail API, configure the OAuth consent
# screen, then create an OAuth 2.0 Client ID of type "Web application".
# The only scope needed is https://www.googleapis.com/auth/gmail.send (plus openid/email
# so the panel can display which account is connected).
#
# GOOGLE_REDIRECT_URI must be listed, character for character, under that client's
# "Authorized redirect URIs". Local development uses the backend on port 8080:
GOOGLE_CLIENT_ID=replace_with_google_oauth_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_oauth_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8080/api/public/email/google/callback
# In production use the public backend URL instead, e.g.
# GOOGLE_REDIRECT_URI=https://api.yourdomain.com/api/public/email/google/callback

# --- WhatsApp Business (official Cloud API by Meta) ---------------------------
# OPTIONAL. Leave WHATSAPP_PROVIDER=NONE to disable: the admin panels then show
# "WhatsApp provider is not configured." and never pretend a message was sent.
# To enable: create a WhatsApp Business app in Meta for Developers, add a phone
# number, generate a permanent System User access token and fill in:
#   WHATSAPP_PROVIDER=META_CLOUD
#   WHATSAPP_ACCESS_TOKEN=<system user token with whatsapp_business_messaging>
#   WHATSAPP_PHONE_NUMBER_ID=<Phone number ID from WhatsApp > API Setup>
#   WHATSAPP_BUSINESS_ACCOUNT_ID=<WhatsApp Business Account ID>
# Free-form text/document messages are only delivered inside a 24-hour customer
# service window; outside it Meta requires an approved message template.
WHATSAPP_PROVIDER=NONE
WHATSAPP_API_URL=https://graph.facebook.com
WHATSAPP_API_VERSION=v20.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# --- Bulk communication throttling -----------------------------------------
# Messages per batch and the pause between batches (milliseconds).
COMM_BATCH_SIZE=25
COMM_BATCH_PAUSE_MS=2000

# --- Application -------------------------------------------------------------
SERVER_PORT=8080
# Public URL of the STATIC FRONTEND. Used to build links inside emails
# (student portal link, password setup link).
PUBLIC_BASE_URL=http://localhost:5500
# Comma-separated. No wildcards — credentials are sent with API requests.
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8080

# --- File storage ------------------------------------------------------------
# Lesson videos and PDFs are stored on disk; only metadata/paths go in MySQL.
STORAGE_BASE_PATH=./uploads
MAX_VIDEO_SIZE_MB=512
MAX_DOCUMENT_SIZE_MB=25
# Ebook PDFs (Main Admin > Ebooks) may be larger than lesson handouts.
MAX_EBOOK_SIZE_MB=100

# --- Support contact shown in outgoing emails --------------------------------
SUPPORT_EMAIL=info@lordsaiinvestment.com
SUPPORT_PHONE=+91 99202 54354

# --- First administrator bootstrap -------------------------------------------
# Used ONCE on first startup to create the initial ADMIN account, only while the
# database has no ADMIN at all. An existing account is never modified.
#
# DEFAULT DEVELOPMENT CREDENTIAL: when these two variables are NOT set, the backend
# seeds  User ID: admin   Password: Admin@123  (email admin@lordsaiinvestment.com).
# Log in at student-login.html?portal=admin. Set real values here before deploying,
# and change the password immediately after the first login.
BOOTSTRAP_ADMIN_EMAIL=admin@lordsaiinvestment.com
BOOTSTRAP_ADMIN_PASSWORD=Admin@123
